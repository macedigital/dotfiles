[alias]
    up = "!git remote update -p; git merge --ff-only @{u}"
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
    type = cat-file -t
    dump = cat-file -p
    fulllog = log --all --decorate --graph --oneline --date=short
    checksig = "!git log --pretty=\"tformat:%Cgreen%h %Cblue%G?%Creset %GK - %aN %C(always,yellow)%s\""
    count = shortlog -sn
    find = log --pretty=\"format:%Cgreen%H %Cblue%s\" --name-status --grep
[branch]
    sort = -committerdate
[color]
    ui = auto
    status = auto
    interactive = always
[color "branch"]
    current = yellow reverse
    local = green
    remote = red
[color "diff"]
    meta = yellow dim
    frag = magenta
    old = red
    new = green
[color "status"]
    added = green
    changed = yellow
    untracked = blue
[column]
    ui = auto
[commit]
    gpgsign = true
    autoWrapCommitMessage = true
    autoWrapWidth = 72
[core]
    autocrlf = input
    safecrlf = true
    eol = native
    quotepath = false
    fileMode = false
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[diff "jpg"]
    textconv = exif
    cachetextconv = true
[fetch]
    prune = true
    pruneTags = true
    all = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[include]
    # Include for username / creds / etc
    path = config.local
[init]
    defaultBranch = main
[merge]
    conflictstyle = zdiff3
[pull]
    rebase = merges
[push]
    default = current
    #default = simple
    autoSetupRemote = true
    followTags = true
    rebase = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[rerere]
    enabled = true
    autoupdate = true
[tag]
    gpgsign = true
    sort = version:refname

