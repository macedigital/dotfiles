# See dunst(5) for all configuration options
# Global override such that default config stays pristine
[global]
  corner_radius = 4
  enable_posix_regex = true
  font = "'MesloLGL Nerd Font Propo' 12"
  frame_width = 1
  icon_corner_radius = 4
  gap_size = 6
  progress_bar_corner_radius = 4
  separator_height = 4

  # Icon settings
  # <https://github.com/dunst-project/dunst/issues/1116>
  enable_recursive_icon_lookup = false
  min_icon_size = 32
  max_icon_size = 96
  icon_theme = Adwaita, hicolor
  icon_path = /usr/share/icons/Adwaita/symbolic/actions/:/usr/share/icons/Adwaita/symbolic/apps/:/usr/share/icons/Adwaita/symbolic/devices/:/usr/share/icons/Adwaita/symbolic/status/:/usr/share/icons/hicolor/22x22/apps/
  default_icon = dialog-information-symbolic

  # Geometry
  width = 300
  height = (75, 300)
  origin = top-right
  offset = (35, 35)

  # Auto-detect if value is 0.
  scale = 0

  # Maximum number of notification (0 means no limit)
  notification_limit = 20
