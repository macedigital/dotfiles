[Context]
filesystems=~/Projects;xdg-config/git:ro;~/.bashrc:ro;~/.local/bin/direnv:ro;~/.local/bin/eza:ro;~/.local/bin/gh:ro;~/.local/bin/just:ro;~/.ssh/config:ro;
shared=network;
sockets=ssh-auth;
persistent=.ssh;

[Session Bus Policy]
org.freedesktop.secrets=talk

[Environment]
FLATPAK_ENABLE_SDK_EXT=golang,node24,rust-stable,openjdk,typescript
