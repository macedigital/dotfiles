[Context]
filesystems=~/Projects;xdg-config/git:ro;~/.bashrc:ro;~/.ssh/config:ro;~/.local/bin/delta:ro;~/.local/bin/mise:ro;
shared=network;
sockets=ssh-auth;
persistent=.ssh;

[Session Bus Policy]
org.freedesktop.secrets=talk

[Environment]
FLATPAK_ENABLE_SDK_EXT=golang,node24,rust-stable,openjdk,typescript
