[Context]
filesystems=~/Projects;xdg-config/git:ro;xdg-data/bash:ro;~/.bashrc:ro;~/.local/bin/direnv:ro;~/.local/bin/gh:ro;~/.ssh/config:ro;~/.ssh/allowed_signers:ro;
shared=network;
sockets=ssh-auth;
persistent=.ssh;

[Session Bus Policy]
org.freedesktop.secrets=talk

[Environment]
FLATPAK_ENABLE_SDK_EXT=golang,node24,rust-stable,openjdk,typescript
SSH_DEFAULT_USER=git
